<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.workouttracker.ui.MainController">

    <VBox styleClass="nav-rail">
        <Label styleClass="nav-brand" text="Workout Tracker"/>
        <ToggleButton fx:id="exercisesNav" styleClass="nav-item" text="Exercises" selected="true"/>
        <ToggleButton fx:id="progressNav" styleClass="nav-item" text="Progress"/>
    </VBox>

    <StackPane HBox.hgrow="ALWAYS">
        <VBox fx:id="exercisesPage" styleClass="page">

            <VBox styleClass="section">
                <Label styleClass="eyebrow" text="Your library"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="headline" text="Exercises"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="editButton" styleClass="button-outlined" text="Edit"
                            onAction="#handleEdit"/>
                    <Button fx:id="deleteButton" styleClass="button-danger" text="Delete"
                            onAction="#handleDelete"/>
                    <Button fx:id="newButton" styleClass="button-filled" text="New exercise"
                            onAction="#handleNew"/>
                </HBox>
            </VBox>

            <!-- Library on the left, the selected exercise's log on the right.
                 The log carries more columns, so it takes the flexible side. -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">

                <!-- Wide enough that the "Weightlifting" chip is not clipped. -->
                <TableView fx:id="exerciseTable" prefWidth="400" minWidth="340">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Exercise" prefWidth="205"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="175"/>
                    </columns>
                </TableView>

                <VBox styleClass="section" HBox.hgrow="ALWAYS">
                    <!-- Title and actions sit on separate rows. Together they
                         overflow the panel and every label truncates. -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="logTitle" styleClass="title" text="Log"/>
                        <Label fx:id="logChip" styleClass="chip" managed="false" visible="false"/>
                        <Label fx:id="logCount" styleClass="secondary"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="editEntryButton" styleClass="button-outlined"
                                text="Edit entry" onAction="#handleEditEntry"/>
                        <Button fx:id="deleteEntryButton" styleClass="button-danger"
                                text="Delete entry" onAction="#handleDeleteEntry"/>
                        <Button fx:id="addEntryButton" styleClass="button-filled"
                                text="Log workout" onAction="#handleAddEntry"/>
                    </HBox>

                    <!-- With nothing selected the table is hidden entirely
                         rather than shown with column headers for measurements
                         that may not even apply to the exercise picked next. -->
                    <StackPane VBox.vgrow="ALWAYS">
                        <Label fx:id="noSelectionMessage" styleClass="secondary"
                               text="Select an exercise to see its log."/>

                        <!-- Only the columns belonging to the selected
                             exercise's category are shown; the controller
                             toggles them. -->
                        <TableView fx:id="entryTable" visible="false">
                            <columns>
                                <!-- Every column carries a minimum, not just a
                                     preference. A constrained resize policy
                                     shrinks past the preference when space is
                                     short, which cut the year off a date and
                                     the hours off a time. -->
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="155"
                                             minWidth="155" maxWidth="175"/>
                                <TableColumn fx:id="setsColumn" text="Sets" prefWidth="90"
                                             minWidth="75"/>
                                <TableColumn fx:id="repsColumn" text="Reps" prefWidth="90"
                                             minWidth="75"/>
                                <TableColumn fx:id="weightColumn" text="Weight (lb)" prefWidth="130"
                                             minWidth="120"/>
                                <TableColumn fx:id="distanceColumn" text="Distance (mi)"
                                             prefWidth="150" minWidth="125"/>
                                <TableColumn fx:id="durationColumn" text="Time" prefWidth="130"
                                             minWidth="100"/>
                                <TableColumn fx:id="paceColumn" text="Pace (/mi)" prefWidth="130"
                                             minWidth="110"/>
                            </columns>
                        </TableView>
                    </StackPane>
                </VBox>

            </HBox>

        </VBox>

        <!-- Progress. One exercise at a time: its records as metric readouts,
             then how the measurement that matters has moved over time. -->
        <VBox fx:id="progressPage" styleClass="page" visible="false" managed="false">

            <VBox styleClass="section">
                <Label styleClass="eyebrow" text="Track improvement"/>
                <Label styleClass="headline" text="Progress"/>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="form-label" text="Exercise"/>
                <ComboBox fx:id="progressChooser" prefWidth="260"/>
                <Label fx:id="progressChip" styleClass="chip" managed="false" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="prChip" styleClass="chip, chip-pr" managed="false" visible="false"/>
            </HBox>

            <HBox spacing="20">
                <VBox styleClass="card, metric" HBox.hgrow="ALWAYS">
                    <Label fx:id="metricOneLabel" styleClass="metric-label" text="—"/>
                    <HBox styleClass="metric-row">
                        <Label fx:id="metricOneValue" styleClass="metric-value" text="—"/>
                        <Label fx:id="metricOneUnit" styleClass="metric-unit"/>
                    </HBox>
                </VBox>
                <VBox styleClass="card, metric" HBox.hgrow="ALWAYS">
                    <Label fx:id="metricTwoLabel" styleClass="metric-label" text="—"/>
                    <HBox styleClass="metric-row">
                        <Label fx:id="metricTwoValue" styleClass="metric-value" text="—"/>
                        <Label fx:id="metricTwoUnit" styleClass="metric-unit"/>
                    </HBox>
                </VBox>
                <VBox styleClass="card, metric" HBox.hgrow="ALWAYS">
                    <Label fx:id="metricThreeLabel" styleClass="metric-label" text="—"/>
                    <HBox styleClass="metric-row">
                        <Label fx:id="metricThreeValue" styleClass="metric-value" text="—"/>
                        <Label fx:id="metricThreeUnit" styleClass="metric-unit"/>
                    </HBox>
                </VBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <Label fx:id="progressMessage" styleClass="secondary" wrapText="true"
                       text="Add an exercise to start tracking progress."/>
                <LineChart fx:id="progressChart" visible="false" legendVisible="false"
                           animated="false">
                    <xAxis>
                        <CategoryAxis fx:id="progressXAxis"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="progressYAxis" forceZeroInRange="false"/>
                    </yAxis>
                </LineChart>
            </StackPane>

        </VBox>
    </StackPane>

</HBox>
